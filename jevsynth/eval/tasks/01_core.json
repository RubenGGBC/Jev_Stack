    },
    "stdout": "7.0",
    "max_steps": 5,
    "oracle": [
      "control:with",
      "builtins.open",
      "lit:'numeros.txt'",
      "control:listcomp",
      "sym:f",
      "builtins.float+x",
      "sym:line",
      "control:nofilter",
      "control:end",
      "builtins.sum@1",
      "sym:values",
      "control:print",
      "sym:result"
    ],
    "tags": [
