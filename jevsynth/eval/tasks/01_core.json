    "tests": [
      "assert solve('app.log') == 2"
    ],
    "max_steps": 5,
    "oracle": [
      "control:with",
      "builtins.open",
      "sym:path",
      "control:listcomp",
      "sym:f",
      "sym:line",
      "operator.contains",
      "sym:line",
      "lit:'ERROR'",
      "control:end",
      "builtins.len",
      "sym:items",
      "control:return",
      "sym:n"
    ],
    "tags": [
      "fase5"
    ]
  },
  {
