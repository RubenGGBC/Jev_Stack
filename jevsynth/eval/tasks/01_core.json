[
  {
    "id": "count_words",
    "prompt": "cuenta las palabras del texto",
    "prompt_en": "count the words in the text",
    "params": [
      [
        "text",
        "str"
      ]
    ],
    "returns": "int",
    "tests": [
      "assert solve('hola que tal') == 3",
      "assert solve('') == 0",
      "assert solve('  uno   dos ') == 2"
    ],
    "max_steps": 4,
    "oracle": [
      "builtins.str.split",
      "sym:text",
      "builtins.len",
      "sym:items",
      "control:return",
      "sym:n"
    ],
    "tags": [
      "fase5"
    ]
  },
  {
    "id": "mean_age",
    "prompt": "lee el CSV de la ruta dada y calcula la media de la columna age",
    "prompt_en": "read the CSV at the given path and compute the mean of the age column",
    "params": [
      [
        "path",
        "str"
      ]
    ],
    "returns": "float",
    "files": {
      "people.csv": "name,age\nana,30\nluis,40\neva,20\n"
    },
    "tests": [
      "assert solve('people.csv') == 30"
    ],
    "max_steps": 6,
    "oracle": [
      "control:with",
      "builtins.open",
      "sym:path",
      "csv.DictReader@1",
      "sym:f",
      "control:listcomp",
      "sym:reader",
      "builtins.float+x",
      "operator.getitem@map",
      "sym:row",
      "lit:'age'",
      "control:nofilter",
      "control:end",
      "statistics.mean",
      "sym:values",
      "control:return",
      "sym:value"
    ],
    "tags": [
      "fase5"
    ]
  },
  {
    "id": "top3_words",
    "prompt": "devuelve las 3 palabras más frecuentes del texto con su número de apariciones",
    "prompt_en": "return the 3 most common words in the text with their counts",
    "params": [
      [
        "text",
        "str"
      ]
    ],
    "returns": "list[tuple[str, int]]",
    "tests": [
      "assert solve('a b a c a b d') == [('a', 3), ('b', 2), ('c', 1)]",
      "assert solve('x') == [('x', 1)]"
    ],
    "max_steps": 5,
    "oracle": [
      "builtins.str.split",
      "sym:text",
      "collections.Counter@3",
      "sym:items",
      "collections.Counter.most_common+n",
      "sym:counts",
      "lit:3",
      "control:return",
      "sym:pairs"
    ],
    "tags": [
      "fase5"
    ]
  },
  {
    "id": "count_error_lines",
